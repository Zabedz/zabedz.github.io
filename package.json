{
	"name": "portfolio",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"packageManager": "pnpm@12.16.1",
	"engines": {
		"node": ">=26"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check src scripts tests .github *.ts *.js *.json *.yaml && eslint src scripts tests *.ts *.js",
		"format": "prettier --write src scripts tests .github *.ts *.js *.json *.yaml",
		"test": "vitest --run",
		"test:e2e": "playwright test",
		"check:dist": "node scripts/check-dist.ts build",
		"fetch:projects": "node scripts/fetch-projects.ts",
		"images": "node scripts/build-images.ts"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@eslint/js": "^10.0.1",
		"@lhci/cli": "^0.15.1",
		"@playwright/test": "^1.64.0",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^26.6.0",
		"@vitest/browser-playwright": "^5.0.5",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.14.0",
		"playwright": "^1.64.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.5",
		"vitest": "^5.0.5",
		"vitest-browser-svelte": "^3.1.0"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
